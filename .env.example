# Secrets for applyloop (.env, created by `applyloop init`). Fill in what you use.
# Keep this file private: never commit it or share it.

# ── AI provider (set the one(s) your config/applyloop.yml `llm` block uses) ──
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                 # use a paid-tier key (free tier may train on your data)
# OLLAMA_MODEL=llama3.1           # free, local (run `ollama serve`)

# Optional one-off overrides of config/applyloop.yml → llm
# APPLYLOOP_PROVIDER=openai
# APPLYLOOP_MODEL=

# ── Job search API (no browser needed) — free at https://developer.adzuna.com ──
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Search API for finding employers on Greenhouse / Lever / Ashby / Workable (search.ats_search) ──
# BRAVE_API_KEY=                  # https://brave.com/search/api — free plan ~2,000 searches/month
# SERPAPI_KEY=                    # or https://serpapi.com (Google results)

# ── Job-alert emails (Indeed / Glassdoor / LinkedIn), read-only IMAP ──
# Gmail: turn on 2-Step Verification, then create an App Password (16 characters).
# APPLYLOOP_IMAP_USER=you@example.com
# APPLYLOOP_IMAP_PASSWORD=
